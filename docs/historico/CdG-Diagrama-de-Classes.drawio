          <mxGeometry as="geometry" x="725.0" y="1029" width="44" height="25" />
        </mxCell>
        <mxCell id="notes" value="/saldo é derivado: despesas pagas − parcelas devidas + pagamentos enviados − recebidos − ajuda oferecida + ajuda recebida.&#10;Saldo positivo: a receber. Saldo negativo: a pagar. Apenas pagamentos confirmados entram no cálculo.&#10;Despesa tem um pagador; seus rateios devem somar o valor da despesa. Sem divisão definida, ela fica pendente.&#10;Pagamento: AGUARDANDO_CONFIRMACAO, CONFIRMADO ou REJEITADO; pagador e recebedor são vínculos distintos do mesmo evento.&#10;Validador deve ser organizador do evento. Despesas, parcelas, pagamentos e contribuições não podem cruzar eventos.&#10;A contribuição reduz o crédito do titular e as dívidas dos beneficiários; suas destinações devem somar o valor oferecido.&#10;O fechamento exige divisões completas, saldos zerados e ausência de pagamentos aguardando confirmação." style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1100" width="1800" height="205" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
