        <mxCell id="p" value="Participante" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;fontSize=18;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="140" width="60" height="90" />
